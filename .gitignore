*.py[cod]
*$py.class

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

*.egg-info/
.eggs/
dist/
build/


# --------------------------------------------
# Alembic
# --------------------------------------------
# Keep migration files committed.
# Do NOT ignore:
# backend/alembic/
# backend/alembic/versions/


# --------------------------------------------
# uv
# --------------------------------------------
# uv.lock should be committed.
# Do NOT ignore uv.lock.


